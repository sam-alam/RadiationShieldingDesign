<Window x:Class="RadiationShieldingDesign.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Language="en-US"
        xmlns:local="clr-namespace:RadiationShieldingDesign"
        xmlns:eng="clr-namespace:RadiationShieldingDesign.Engine;assembly=RadiationShieldingDesign.Engine"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Radiation Shielding Designer (RSD)"
        Height="720" Width="1200"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        Icon="pack://application:,,,/Data/favicon256.ico"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:DoubleFractionConverter x:Key="DoubleFractionConverter"/>
        <local:MetersToFeetConverter x:Key="M2FStr"/>
        <local:GaugeToBrushConverter x:Key="GaugeToBrushConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:BoolInvertConverter x:Key="BoolInvertConverter"/>
        <local:BoolToBrushConverter x:Key="BoolToGrayBrushConverter" TrueBrush="SlateGray" FalseBrush="White"/>
        <local:EqualsToBoolConverter x:Key="EqualsToBool"/>
        <local:DoubleParseConverter x:Key="DoubleParseConverter"/>
        <!-- ═══ MD control style fallbacks — BasedOn inherits WPF UI dark theme ═══ -->

        <Style x:Key="RsdTextBox" TargetType="TextBox"
       BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#60FFFFFF"/>
            <Setter Property="Background" Value="#3F464F"/>
            <Setter Property="Foreground" Value="White"/>
            <!-- Make selected text clearly visible on the dark background -->
            <Setter Property="SelectionBrush" Value="#4FA3FF"/>
            <Setter Property="SelectionOpacity" Value="0.55"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Background" Value="#454D57"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#58616C"/>
                    <Setter Property="BorderBrush" Value="#7A8694"/>
                    <Setter Property="Foreground" Value="#E6E6E6"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RsdComboBox" TargetType="ComboBox"
       BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RsdPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4F8FD9"/>
            <Setter Property="BorderBrush" Value="#7FB8F0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66A6EB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A8D1F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E78BB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8DBBEA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D6EBFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RsdButton" TargetType="Button">
            <Setter Property="Background" Value="#3A4552"/>
            <Setter Property="BorderBrush" Value="#728090"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#465363"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#91A0B2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313B47"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A1B1C2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A7D0F5"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RsdFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#143A78C2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#223A78C2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#64B5F6"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RsdToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#343A40"/>
            <Setter Property="BorderBrush" Value="#5A616A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A86C5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3F78B5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40474F"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#5A95D1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A95D1"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A7D0F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ═══ MaterialDesign typography fallbacks ═══ -->
        <Style x:Key="MaterialDesignHeadline5TextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="LineHeight" Value="32"/>
        </Style>

        <Style x:Key="MaterialDesignHeadline6TextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="LineHeight" Value="28"/>
        </Style>

        <Style x:Key="MaterialDesignSubtitle1TextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="LineHeight" Value="24"/>
        </Style>

        <Style x:Key="MaterialDesignSubtitle2TextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>

        <Style x:Key="MaterialDesignBody1TextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="MaterialDesignBody2TextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <Style x:Key="MaterialDesignCaptionTextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <Style x:Key="MaterialDesignButtonTextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="MaterialDesignOverlineTextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <Style x:Key="RsdSectionOverlineTextBlock"
       TargetType="TextBlock"
       BasedOn="{StaticResource MaterialDesignOverlineTextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <!-- Fallback overline style + updated list styles for MD dark theme -->
      
        <Style x:Key="MellowListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="MellowListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A1976D2"/>
                    <Setter Property="BorderBrush" Value="#661976D2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Update ThicknessTextBrush for dark theme legibility -->
        <SolidColorBrush x:Key="ThicknessTextBrush" Color="#CE93D8"/>


        <Style x:Key="BoldHeader" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="CenterHeader" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource BoldHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Center cell content -->
        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#44484D"/>
            <Setter Property="BorderBrush" Value="#555D66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FormReadout" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline5TextBlock}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="84"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        
        <Style TargetType="GroupBox">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeadersPresenter">
            <Setter Property="Background" Value="#2F2F2F"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BoldHeader}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="#252525"/>
            <Setter Property="AlternatingRowBackground" Value="#2D2D2D"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3A3A3A"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3A3A3A"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A3F5F"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#34527A"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A3F5F"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#64B5F6"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#64B5F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"/>
                                <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="#252525"
                                    BorderBrush="#4A4A4A"
                                    BorderThickness="1"
                                    Padding="2">
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#353535"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F2F2F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1,1,1,0"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                      ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6AA9FF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Panel.ZIndex" Value="10"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#353535"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                            </MultiTrigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" SnapsToDevicePixels="True">
                            <Border x:Name="Box"
                            Width="16" Height="16"
                            CornerRadius="2"
                            Background="#2B2B2B"
                            BorderBrush="#6A6A6A"
                            BorderThickness="1"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                              Data="M 3 8 L 6.5 11.5 L 13 4.5"
                              Stroke="White"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1565C0"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#90CAF9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#64B5F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" SnapsToDevicePixels="True">
                            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Outer"
                                 Fill="#2B2B2B"
                                 Stroke="#6A6A6A"
                                 StrokeThickness="1"/>
                                <Ellipse x:Name="Inner"
                                 Width="8" Height="8"
                                 Fill="White"
                                 Visibility="Collapsed"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Fill" Value="#1976D2"/>
                                <Setter TargetName="Outer" Property="Stroke" Value="#1565C0"/>
                                <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Stroke" Value="#90CAF9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outer" Property="StrokeThickness" Value="2"/>
                                <Setter TargetName="Outer" Property="Stroke" Value="#64B5F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#353535"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A3F5F"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DisabledTextCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type materialDesign:Card}">
            <Setter Property="Background" Value="#44484D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="CoeffHeaderBorder" TargetType="Border">
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CoeffSubHeaderBorder" TargetType="Border">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CoeffHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CoeffSubHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel>

        <!-- TOP MENU -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Switch Room" Click="MenuSwitchRoom_Click" />
                <Separator/>
                <MenuItem Header="_Load design" Click="MenuOpen_Click"/>
                <Separator/>
                <MenuItem Header="_Save design" Click="MenuSave_Click"/>
                <MenuItem Header="Save _As..." Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem Header="_Export Report..." Click="MenuExport_Click"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Tips" Click="MenuTips_Click"/>
                <MenuItem Header="About" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>
        <TabControl x:Name="MainTabs" Background="#252A31">
            <!-- ================= TAB: DESIGN ================= -->
            <TabItem x:Name="DesignTabItem" Header="Design">
                <Grid>

                    <!-- ─── Welcome / Start State ─── -->
                    <materialDesign:Card
            Visibility="{Binding HasActiveDesign, Converter={StaticResource BoolInvertConverter}, ConverterParameter=vis}"
            IsHitTestVisible="{Binding HasActiveDesign, Converter={StaticResource BoolInvertConverter}}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="480" UniformCornerRadius="16">
                        <StackPanel Margin="44,38">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="FloorPlan" Width="28" Height="28"
                                             VerticalAlignment="Center" Margin="0,0,12,0"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="New Room Design"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Select a room category, name the room, and start designing."
                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                           Opacity="0.65" TextWrapping="Wrap" Margin="0,4,0,28"/>

                            <TextBox Style="{StaticResource RsdTextBox}"
                         materialDesign:HintAssist.Hint="Room name (e.g., TC-307, X-ray 1)"
                         
                         Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"
                         ToolTip="e.g., TC-307, X-ray 1, 575 Lex DR1"/>

                            <ComboBox Style="{StaticResource RsdComboBox}"
                          materialDesign:HintAssist.Hint="Room category"
                          
                          ItemsSource="{Binding RoomCategories}"
                          SelectedItem="{Binding SelectedRoomCategory}"
                          Margin="0,0,0,32"/>

                            <Button Content="START DESIGNING"
                        Command="{Binding StartDesignCommand}"
                        Style="{StaticResource RsdPrimaryButton}"
                        Padding="32,10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ─── Active Design Grid ─── -->
                    <Grid Visibility="{Binding HasActiveDesign, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="280"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="5*" MinWidth="500"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="3*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- ══════════════════════ LEFT PANEL ══════════════════════ -->
                        <ScrollViewer Grid.Column="0" Padding="10">
                            <StackPanel>

                                <!-- CARD: Room Identity + Tools -->
                                <materialDesign:Card Margin="0,0,0,10" UniformCornerRadius="10">
                                    <StackPanel Margin="14,12">

                                        <!-- Room type badge -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <materialDesign:PackIcon Kind="Domain" Width="20" Height="20"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="Type: " Opacity="0.6" FontSize="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedRoomCategory}"
                                           FontWeight="Bold" FontSize="18" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </StackPanel>

                                        <!-- Room name -->
                                        <TextBlock Text="Room name:" Opacity="0.6" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource RsdTextBox}"
                                     materialDesign:HintAssist.Hint="Room name"
                                     Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14"
                                     ToolTip="Room name shown on the report"/>

                                        <!-- Canvas tools -->
                                        <TextBlock Text="CANVAS TOOLS"
                                       Style="{StaticResource RsdSectionOverlineTextBlock}"
                                       Opacity="0.6" Margin="0,0,0,8"/>
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button Content="Import layout…"
                                        Click="ImportBackground_Click"
                                        Style="{StaticResource RsdButton}"
                                        Margin="0,0,6,6" Padding="8,4"/>
                                            <ToggleButton Content="Pan Background"
              IsChecked="{Binding IsEditingBackground}"
              Style="{StaticResource RsdToggleButton}"
              Margin="0,0,6,6"/>
                                            <Button Content="−" Click="BgZoomOut_Click"
                                        Style="{StaticResource RsdButton}"
                                        Width="32" Height="32" Padding="0" Margin="0,0,4,6"/>
                                            <Button Content="+" Click="BgZoomIn_Click"
                                        Style="{StaticResource RsdButton}"
                                        Width="32" Height="32" Padding="0" Margin="0,0,0,6"/>
                                        </WrapPanel>

                                        <!-- Scale / Measure -->
                                        <TextBlock Text="SCALE &amp; MEASURE"
                                       Style="{StaticResource RsdSectionOverlineTextBlock}"
                                       Opacity="0.6" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Button Grid.Column="0" Content="Set Scale"
                                        Command="{Binding StartMeasureScaleCommand}"
                                        Style="{StaticResource RsdButton}"/>
                                            <TextBox  Grid.Column="1"
                                         Style="{StaticResource RsdTextBox}"
                                         Text="{Binding CmPerPixel, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Width="60" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="(cm/pixel)" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Button Content="Measure Distance"
                                    Command="{Binding StartMeasureDistanceCommand}"
                                    Style="{StaticResource RsdButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Padding="108,8"/>
                                        
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- CARD: PET Parameters (conditional) -->
                                <materialDesign:Card Margin="0,0,0,10" UniformCornerRadius="10"
                                         Visibility="{Binding IsPET, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Margin="14,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <materialDesign:PackIcon Kind="Radioactive" Width="18" Height="18"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="PET Parameters"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <ComboBox Style="{StaticResource RsdComboBox}"
                                      materialDesign:HintAssist.Hint="Isotope"
                                      
                                      ItemsSource="{Binding PetIsotopeOptions}"
                                      SelectedItem="{Binding SelectedIsotope}"
                                      Margin="0,0,0,12"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBox Grid.Row="0" Grid.Column="0"
                                         Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="Admin (MBq)"
                                         
                                         Text="{Binding PetAdmin_MBq_Text, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,10"/>
                                            <TextBox Grid.Row="0" Grid.Column="2"
                                         Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="Uptake (min)"
                                         
                                         Text="{Binding PetUptake_min_Text, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,10"/>
                                            <TextBox Grid.Row="1" Grid.Column="0"
                                         Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="Imaging (min)"
                                         
                                         Text="{Binding PetImaging_min_Text, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,10"/>
                                            <TextBox Grid.Row="1" Grid.Column="2"
                                         Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="Voiding factor"
                                         
                                         Text="{Binding PetVoidingFactor_Text, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,10"/>
                                        </Grid>

                                        <TextBlock Text="Patient dose rate (µSv·m²/MBq·h)"
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       Opacity="0.6" Margin="0,2,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="Manual"
                                          IsChecked="{Binding PetPatientDoseConstManual}"
                                          Margin="0,0,16,0" VerticalAlignment="Center"/>
                                            <TextBox Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="Value"
                                         
                                         Text="{Binding PetPatientDoseConst_Text, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding PetPatientDoseConstManual}"
                                         Width="90" HorizontalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- CARD: SPECT Parameters (conditional) -->
                                <materialDesign:Card Margin="0,0,0,10" UniformCornerRadius="10"
                                         Visibility="{Binding IsSPECT, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Margin="14,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <materialDesign:PackIcon Kind="Radioactive" Width="18" Height="18"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="SPECT Parameters"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Tick each study the site performs and enter patients/week. Activities in mCi, times in minutes."
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       TextWrapping="Wrap" Opacity="0.6" Margin="0,0,0,10"/>

                                        <ItemsControl ItemsSource="{Binding SpectStudies}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,8">
                                                        <CheckBox Content="{Binding Protocol}" IsChecked="{Binding IsEnabled}"
                                                      FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <StackPanel Margin="22,0,0,4"
                                                       Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                                         HorizontalContentAlignment="Center"
                                                                         Text="{Binding PatientsPerWeekText, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <TextBlock Text="Patients / week" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                            </DockPanel>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                                         HorizontalContentAlignment="Center"
                                                                         Text="{Binding Activity1Text, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <TextBlock Text="{Binding Activity1Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                            </DockPanel>
                                                            <DockPanel Margin="0,0,0,6"
                                                                       Visibility="{Binding HasActivity2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                                         HorizontalContentAlignment="Center"
                                                                         Text="{Binding Activity2Text, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <TextBlock Text="{Binding Activity2Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                            </DockPanel>
                                                            <DockPanel Margin="0,0,0,6"
                                                                       Visibility="{Binding HasWait, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                                         HorizontalContentAlignment="Center"
                                                                         Text="{Binding WaitText, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <TextBlock Text="{Binding WaitLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                            </DockPanel>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                                         HorizontalContentAlignment="Center"
                                                                         Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <TextBlock Text="Scan (min)" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                            </DockPanel>
                                                            <DockPanel Margin="0,0,0,6"
                                                                       Visibility="{Binding HasGap, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                                         HorizontalContentAlignment="Center"
                                                                         Text="{Binding GapText, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <TextBlock Text="{Binding GapLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                            </DockPanel>
                                                            <DockPanel Margin="0,0,0,6"
                                                                       Visibility="{Binding HasStress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                                         HorizontalContentAlignment="Center"
                                                                         Text="{Binding StressText, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <TextBlock Text="Stress (min)" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                            </DockPanel>
                                                            <DockPanel Margin="0,0,0,6"
                                                                       Visibility="{Binding HasStress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                                         HorizontalContentAlignment="Center"
                                                                         Text="{Binding PostStressWaitText, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <TextBlock Text="Post-stress wait (min)" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="HOURLY CHECK (uncontrolled areas)"
                                       Style="{StaticResource RsdSectionOverlineTextBlock}"
                                       Opacity="0.6" Margin="0,6,0,8"/>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                         HorizontalContentAlignment="Center"
                                                         Text="{Binding SpectMaxPtsWaitingText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Max patients at once: waiting" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                         HorizontalContentAlignment="Center"
                                                         Text="{Binding SpectMaxPtsCameraText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Max patients at once: camera" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                         HorizontalContentAlignment="Center"
                                                         Text="{Binding SpectMaxPtsStressText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Max patients at once: stress" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource RsdTextBox}" Width="80"
                                                         HorizontalContentAlignment="Center"
                                                         Text="{Binding SpectHourlyLimitText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Hourly limit (mSv in any hour)" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Divider -->
                                <Rectangle Height="1" Fill="{DynamicResource MaterialDesignDivider}" Margin="0,2,0,10"/>

                                <!-- Selected barrier section header -->
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                                    <materialDesign:PackIcon Kind="VectorLine" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <TextBlock Text="Selected Barrier"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Selected barrier inputs (collapsed when null) -->
                                <StackPanel DataContext="{Binding SelectedBarrier}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- CARD: Identification -->
                                    <materialDesign:Card Margin="0,0,0,10" UniformCornerRadius="10">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="IDENTIFICATION"
                                           Style="{StaticResource RsdSectionOverlineTextBlock}"
                                           Opacity="0.6" Margin="0,0,0,10"/>

                                            <Expander Header="Thickness round-up options" IsExpanded="False" Margin="0,0,0,12">
                                                <StackPanel Margin="0,8,0,0">
                                                    <ComboBox Style="{StaticResource RsdComboBox}"
                                                  materialDesign:HintAssist.Hint="Rounding rule"
                                                  SelectedValue="{Binding ThicknessRoundingRule, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  Margin="0,0,0,8">
                                                        <ComboBoxItem Content="Auto" Tag="{x:Static local:ThicknessRoundingRule.Auto}"/>
                                                        <ComboBoxItem Content="Round up +1 step" Tag="{x:Static local:ThicknessRoundingRule.RoundUpPlus1Step}"/>
                                                        <ComboBoxItem Content="Round up +2 steps" Tag="{x:Static local:ThicknessRoundingRule.RoundUpPlus2Steps}"/>
                                                        <ComboBoxItem Content="Minimum 1/16&quot;" Tag="{x:Static local:ThicknessRoundingRule.Minimum_1_16}"/>
                                                        <ComboBoxItem Content="Minimum 1/32&quot;" Tag="{x:Static local:ThicknessRoundingRule.Minimum_1_32}"/>
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding FinalThicknessShortDisplay, Mode=OneWay, StringFormat=Final: {0}}"
                                                   FontWeight="SemiBold"
                                                   Visibility="{Binding HasThicknessRounding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding ThicknessShortDisplay, Mode=OneWay, StringFormat=Req: {0}}"
                                                   Opacity="0.7"/>
                                                </StackPanel>
                                            </Expander>

                                            <ComboBox Style="{StaticResource RsdComboBox}"
                                          materialDesign:HintAssist.Hint="Barrier designation"
                                          
                                          ItemsSource="{Binding DataContext.AllDesignations, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Designation}"
                                          Margin="0,0,0,10"/>

                                            <!-- PET region (conditional) -->
                                            <StackPanel Visibility="{Binding ShowPetRegionSelector, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ComboBox Style="{StaticResource RsdComboBox}"
                                              materialDesign:HintAssist.Hint="PET source region"
                                              
                                              SelectedValue="{Binding PetRegion}"
                                              SelectedValuePath="Tag"
                                              Margin="0,0,0,10">
                                                    <ComboBoxItem Content="Uptake" Tag="{x:Static eng:PetSourceRegion.Uptake}"/>
                                                    <ComboBoxItem Content="PET" Tag="{x:Static eng:PetSourceRegion.PetRoom}"/>
                                                    <ComboBoxItem Content="Both" Tag="{x:Static eng:PetSourceRegion.Both}"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- SPECT suite: source regions this barrier sees (conditional) -->
                                            <StackPanel Visibility="{Binding ShowSpectRegionSelector, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Margin="0,0,0,10">
                                                <TextBlock Text="SPECT SOURCE REGIONS SEEN"
                                               Style="{StaticResource RsdSectionOverlineTextBlock}"
                                               Opacity="0.6" Margin="0,0,0,6"/>
                                                <WrapPanel>
                                                    <CheckBox Content="Waiting" IsChecked="{Binding SpectSeesWaiting}" Margin="0,0,16,0"/>
                                                    <CheckBox Content="Camera" IsChecked="{Binding SpectSeesCamera}" Margin="0,0,16,0"/>
                                                    <CheckBox Content="Stress" IsChecked="{Binding SpectSeesStress}"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <TextBox Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="Label (e.g., AB, W1)"
                                         
                                         Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                         local:EnterUpdatesTextBox.UpdateOnEnter="True"
                                         Margin="0,0,0,10"/>

                                            <WrapPanel>
                                                <CheckBox Content="Hide label"
                                              IsChecked="{Binding IsLabelHidden, Mode=TwoWay}"
                                              Margin="0,0,12,6"/>
                                                <CheckBox Content="Show all labels"
                                              IsChecked="{Binding ElementName=Root, Path=DataContext.ShowBarrierLabels}"
                                              Margin="0,0,12,6"/>
                                                <CheckBox Content="Hide on canvas"
                                              IsChecked="{Binding IsHiddenOnCanvas}"
                                              Margin="0,0,0,6"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- CARD: Shielding + Distance -->
                                    <materialDesign:Card Margin="0,0,0,10" UniformCornerRadius="10">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="SHIELDING"
                                           Style="{StaticResource RsdSectionOverlineTextBlock}"
                                           Opacity="0.6" Margin="0,0,0,10"/>

                                            <ComboBox Style="{StaticResource RsdComboBox}"
                                          materialDesign:HintAssist.Hint="Material"
                                          
                                          ItemsSource="{Binding DataContext.MaterialNamesForUi, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding MaterialName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,10"/>

                                            <TextBox Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="Area beyond barrier"
                                         
                                         Text="{Binding ProtectedArea, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,14"/>

                                            <TextBlock Text="DISTANCE"
                                           Style="{StaticResource RsdSectionOverlineTextBlock}"
                                           Opacity="0.6" Margin="0,0,0,10"/>

                                            <Border Background="#0CFFFFFF" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding DisplayDistance_m, Converter={StaticResource M2FStr}, StringFormat=Canvas: {0}}"
                                               FontSize="12" Opacity="0.8"/>
                                            </Border>

                                            <WrapPanel Margin="0,0,0,8">
                                                <CheckBox Content="Save canvas distance"
                                              IsChecked="{Binding SaveDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,16,0"/>
                                                <CheckBox Content="Snap to source"
                                              IsChecked="{Binding SnapToSource}"/>
                                            </WrapPanel>

                                            <TextBox Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="Override distance (ft) — 0 to use drawing"
                                         
                                         Text="{Binding DistanceOverrideFtText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OverrideDistanceTextBox_KeyDown"
                                         Margin="0,0,0,8"/>

                                            <Border Background="#0C1f6feb" BorderBrush="#221f6feb" BorderThickness="1"
                                        CornerRadius="6" Padding="10,7">
                                                <TextBlock Text="{Binding EffectiveDistance_m, Converter={StaticResource M2FStr}, StringFormat=Used in calc: {0}}"
                                               Foreground="#64B5F6" FontSize="12"/>
                                            </Border>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- CARD: Zone & Dose Limits -->
                                    <materialDesign:Card Margin="0,0,0,10" UniformCornerRadius="10">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="ZONE &amp; DOSE LIMITS"
                                           Style="{StaticResource RsdSectionOverlineTextBlock}"
                                           Opacity="0.6" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                              Style="{StaticResource RsdComboBox}"
                                              materialDesign:HintAssist.Hint="Zone"
                                              
                                              ItemsSource="{Binding DataContext.ZoneTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Zone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="2"
                                             Style="{StaticResource RsdTextBox}"
                                             materialDesign:HintAssist.Hint="P (mGy/wk)"
                                             
                                             Text="{Binding PMGyWeek, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             local:EnterUpdatesTextBox.UpdateOnEnter="True"/>
                                            </Grid>

                                            <TextBlock Text="USE FACTOR &amp; OCCUPANCY"
                                           Style="{StaticResource RsdSectionOverlineTextBlock}"
                                           Opacity="0.6" Margin="0,4,0,10"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                             Style="{StaticResource RsdTextBox}"
                                             materialDesign:HintAssist.Hint="Use factor U"
                                             
                                             Text="{Binding UseFactor, UpdateSourceTrigger=PropertyChanged}"
                                             local:EnterUpdatesTextBox.UpdateOnEnter="True"/>
                                                <ComboBox Grid.Column="2"
                                              Style="{StaticResource RsdComboBox}"
                                              materialDesign:HintAssist.Hint="Occupancy T"
                                              
                                              ItemsSource="{Binding DataContext.OccupancyChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Occupancy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource DoubleFractionConverter}}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- CARD: Air-Kerma K -->
                                    <materialDesign:Card Margin="0,0,0,10" UniformCornerRadius="10">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="UNSHIELDED AIR-KERMA K (mGy/pt)"
                                           Style="{StaticResource RsdSectionOverlineTextBlock}"
                                           Opacity="0.6" Margin="0,0,0,10"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <CheckBox Content="Manual"
                                              IsChecked="{Binding K1ManualOverride, Mode=TwoWay}"
                                              Margin="0,0,20,0" VerticalAlignment="Center"/>
                                                <CheckBox Content="Use NCRP value"
                                              IsChecked="{Binding UseNcrpK}"
                                              IsEnabled="{Binding CanUseNcrpK}"
                                              Style="{StaticResource DisabledTextCheckBoxStyle}"
                                              VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBox Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="K value"
                                         
                                         Text="{Binding K1Text, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsK1InputEnabled}"
                                         Margin="0,0,0,10"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="Source: " Opacity="0.6" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Background="{DynamicResource PrimaryHueMidBrush}"
                                            CornerRadius="4" Padding="8,3">
                                                    <TextBlock Text="{Binding KSource}"
                                                   Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Tertiary CT (conditional) -->
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                            Visibility="{Binding DataContext.IsCT,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource BooleanToVisibilityConverter}}"
                                            VerticalAlignment="Center">
                                                <CheckBox Content="Tertiary (Sutton)"
                                              IsChecked="{Binding IsCtTertiary}"
                                              IsEnabled="{Binding DataContext.CtHasDlpWeek,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Barrier Ht. (m):" VerticalAlignment="Center"
                                               FontSize="12" Margin="0,0,6,0"/>
                                                <TextBox Style="{StaticResource RsdTextBox}"
                                             Text="{Binding TertiaryHeightText, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                             IsEnabled="{Binding IsCtTertiary}"
                                             Width="55" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- CARD: Pre-shield + Pre-existing -->
                                    <materialDesign:Card Margin="0,0,0,10" UniformCornerRadius="10">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="PRE-SHIELD"
                                           Style="{StaticResource RsdSectionOverlineTextBlock}"
                                           Opacity="0.6" Margin="0,0,0,10"/>

                                            <CheckBox Content="Apply primary pre-shield"
                                          IsChecked="{Binding ApplyPreShield}"
                                          IsEnabled="{Binding IsPreShieldEditable}"
                                          Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                              Style="{StaticResource RsdComboBox}"
                                              materialDesign:HintAssist.Hint="Type"
                                              
                                              ItemsSource="{Binding DataContext.PreShieldTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding PreShieldType}"
                                              IsEnabled="{Binding ApplyPreShield}"/>
                                                <TextBox Grid.Column="2"
                                             Style="{StaticResource RsdTextBox}"
                                             materialDesign:HintAssist.Hint="mm"
                                             
                                             Text="{Binding PreShield_mm, Mode=OneWay, StringFormat=F2}"
                                             IsReadOnly="True"
                                             IsEnabled="{Binding ApplyPreShield}"/>
                                            </Grid>

                                            <TextBlock Text="PRE-EXISTING SHIELDING"
                                           Style="{StaticResource RsdSectionOverlineTextBlock}"
                                           Opacity="0.6" Margin="0,0,0,10"/>

                                            <ComboBox Style="{StaticResource RsdComboBox}"
                                          materialDesign:HintAssist.Hint="Material"
                                          
                                          ItemsSource="{Binding DataContext.PreexistingMaterialNamesForUi, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding NewPreMat, Mode=TwoWay, TargetNullValue={x:Null}}"
                                          Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                             Style="{StaticResource RsdTextBox}"
                                             materialDesign:HintAssist.Hint="Thickness"
                                             
                                             Text="{Binding NewPreThk, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=G}"
                                             local:EnterUpdatesTextBox.UpdateOnEnter="True"
                                             ToolTip="Enter a number (decimals ok)"/>
                                                <ComboBox Grid.Column="2"
                                              Style="{StaticResource RsdComboBox}"
                                              materialDesign:HintAssist.Hint="Unit"
                                              ItemsSource="{Binding DataContext.ThicknessUnits, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding NewPreUnit, Mode=TwoWay}"/>
                                                <Button Grid.Column="4" VerticalAlignment="Bottom"
                                            Content="Add"
                                            Command="{Binding DataContext.AddPreLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource RsdButton}"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding PreexistingLayers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#0DFFFFFF" CornerRadius="6"
                                                    Padding="10,6" Margin="0,0,0,4">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                                        <Run Text="{Binding MaterialName}"/>
                                                        <Run Text=" — "/>
                                                        <Run Text="{Binding ThicknessValue, StringFormat=G}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding ThicknessUnit}"/>
                                                                </TextBlock>
                                                                <Button DockPanel.Dock="Right"
                                                            Content="Remove"
                                                            Command="{Binding DataContext.RemovePreLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RsdFlatButton}"
                                                            Foreground="#EF9A9A"
                                                            Padding="6,2" Height="Auto"/>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- Compute + Export -->
                                    <Grid Margin="0,4,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                    Content="Compute Selected"
                                    Command="{Binding DataContext.ComputeSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource RsdButton}"
                                    Padding="4,8"/>
                                        <Button Grid.Column="2"
                                    Content="Compute All"
                                    Command="{Binding DataContext.ComputeAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource RsdPrimaryButton}"
                                    Padding="4,8"/>
                                    </Grid>
                                    <Button Content="Export Report…"
                                Click="SaveReport_Click"
                                Style="{StaticResource RsdButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,6,0,16"/>
                                </StackPanel>

                                <!-- Hint when no barrier selected -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedBarrier}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CursorDefaultClick" Width="15" Height="15"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.4"/>
                                        <TextBlock Text="Click a barrier on the canvas to select it."
                                       Opacity="0.4" FontStyle="Italic" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- SPLITTER: LEFT ↔ CENTER -->
                        <GridSplitter Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE" Background="#22000000"/>

                        <!-- ══════════════════════ CENTER: Canvas (unchanged) ══════════════════════ -->
                        <Border Grid.Column="2" Background="#14181D" Margin="6" CornerRadius="6">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                                        <TextBlock Text="Set gap (ft):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="GapBox"
         Width="80"
         VerticalAlignment="Center"
         Margin="0,0,8,0"
         Text="2.50"
         ToolTip="Enter distance in ft"
         Style="{StaticResource RsdTextBox}"/>

                                        <Button Content="Apply Gap (ft)"
        Style="{StaticResource RsdButton}"
        Command="{Binding SetGapCommand}"
        CommandParameter="{Binding ElementName=GapBox, Path=Text, Converter={StaticResource DoubleParseConverter}}"
        ToolTip="Enter desired distance. Select wall A, then wall B; Click Apply Gap. Moves the current wall to achieve the gap. Only works for parallel walls."/>
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <Grid.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                                        </Grid.LayoutTransform>

                                        <Canvas x:Name="DesignCanvas"
                                    Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                    MouseMove="Canvas_MouseMove"
                                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                                    MouseRightButtonDown="Canvas_MouseRightButtonDown">
                                            <Canvas.Style>
                                                <Style TargetType="Canvas">
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMeasuringScale}" Value="True">
                                                            <Setter Property="Cursor" Value="SizeNESW"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMeasuringDistance}" Value="True">
                                                            <Setter Property="Cursor" Value="Cross"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Canvas.Style>

                                            <Canvas.Background>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute"
                                                  Viewbox="0,0,20,20" ViewboxUnits="Absolute" Opacity="0.25">
                                                    <DrawingBrush.Drawing>
                                                        <GeometryDrawing>
                                                            <GeometryDrawing.Pen>
                                                                <Pen Thickness="1" Brush="#444"/>
                                                            </GeometryDrawing.Pen>
                                                            <GeometryDrawing.Geometry>
                                                                <RectangleGeometry Rect="0,0,20,20"/>
                                                            </GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Canvas.Background>

                                            <Image Panel.ZIndex="0"
                                       Source="{Binding BackgroundImage}"
                                       Opacity="{Binding BackgroundOpacity}"
                                       IsHitTestVisible="False">
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="{Binding BackgroundScale}" ScaleY="{Binding BackgroundScale}"/>
                                                        <TranslateTransform X="{Binding BackgroundOffsetX}" Y="{Binding BackgroundOffsetY}"/>
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>

                                            <Ellipse Width="12" Height="12" Fill="Orange"
                                         Canvas.Left="{Binding TubeX}" Canvas.Top="{Binding TubeY}">
                                                <Ellipse.ToolTip>Source (drag me)</Ellipse.ToolTip>
                                            </Ellipse>

                                            <!-- Barriers -->
                                            <ItemsControl Panel.ZIndex="10" ItemsSource="{Binding Barriers}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Panel.ZIndex" Value="10"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Panel.ZIndex" Value="999"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Line Panel.ZIndex="10"
                                                      X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                      Visibility="{Binding VisibleOnCanvas, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Line.Style>
                                                                    <Style TargetType="Line">
                                                                        <Setter Property="Stroke" Value="{Binding GaugeKey, Converter={StaticResource GaugeToBrushConverter}}"/>
                                                                        <Setter Property="StrokeThickness" Value="5"/>
                                                                        <Setter Property="StrokeStartLineCap" Value="Round"/>
                                                                        <Setter Property="StrokeEndLineCap" Value="Round"/>
                                                                        <Setter Property="Opacity" Value="0.95"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Stroke" Value="Gold"/>
                                                                                <Setter Property="StrokeThickness" Value="6"/>
                                                                                <Setter Property="Opacity" Value="1.0"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Line.Style>
                                                            </Line>
                                                            <!--<Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                      Panel.ZIndex="10"
                                                      Visibility="{Binding VisibleOnCanvas, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Line.Style>
                                                                    <Style TargetType="Line">
                                                                        <Setter Property="Stroke" Value="{Binding GaugeKey, Converter={StaticResource GaugeToBrushConverter}}"/>
                                                                        <Setter Property="StrokeThickness" Value="5"/>
                                                                        <Setter Property="StrokeStartLineCap" Value="Round"/>
                                                                        <Setter Property="StrokeEndLineCap" Value="Round"/>
                                                                        <Setter Property="Opacity" Value="0.95"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="StrokeThickness" Value="6"/>
                                                                                <Setter Property="Opacity" Value="1.0"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Line.Style>
                                                            </Line>-->
                                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                      Panel.ZIndex="20" Stroke="#FF000000"
                                                      StrokeThickness="2" StrokeDashArray="3,3"
                                                      IsHitTestVisible="False">
                                                                <Line.Style>
                                                                    <Style TargetType="Line">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                                    <Condition Binding="{Binding VisibleOnCanvas}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Line.Style>
                                                            </Line>
                                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                      Panel.ZIndex="-1" Stroke="#222" StrokeThickness="8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                                <Line.Style>
                                                                    <Style TargetType="Line">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding DataContext.IsExporting, ElementName=Root}" Value="True"/>
                                                                                    <Condition Binding="{Binding VisibleOnCanvas}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Line.Style>
                                                            </Line>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Labels -->
                                            <ItemsControl ItemsSource="{Binding Barriers}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding LabelX}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding LabelY}"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" Foreground="OrangeRed"
                                                       FontWeight="Bold" FontSize="24">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ElementName=Root, Path=DataContext.ShowBarrierLabels}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsLabelHidden}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Measure lines -->
                                            <Line Stroke="Yellow" StrokeThickness="2"
                                      Visibility="{Binding IsMeasuringScale, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      X1="{Binding MeasureX1}" Y1="{Binding MeasureY1}"
                                      X2="{Binding MeasureX2}" Y2="{Binding MeasureY2}"/>
                                            <Line Stroke="Red" StrokeThickness="2"
                                      Visibility="{Binding IsMeasuringDistance, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      X1="{Binding MeasureX1}" Y1="{Binding MeasureY1}"
                                      X2="{Binding MeasureX2}" Y2="{Binding MeasureY2}"/>
                                        </Canvas>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <!-- SPLITTER: CENTER ↔ RIGHT -->
                        <GridSplitter Grid.Column="3" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE" Background="#22000000"/>

                        <!-- ══════════════════════ RIGHT PANEL ══════════════════════ -->
                        <ScrollViewer x:Name="RightPanelScroll" Grid.Column="4" Padding="10">
                            <StackPanel>

                                <!-- Barriers header + buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="Wall" Width="20" Height="20"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <TextBlock Text="Barriers"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Add Primary"
                                Command="{Binding AddPrimaryCommand}"
                                Style="{StaticResource RsdButton}"
                                Margin="0,0,6,6" Padding="8,4"/>
                                    <Button Content="Add Secondary"
                                Command="{Binding AddSecondaryCommand}"
                                Style="{StaticResource RsdButton}"
                                Margin="0,0,6,6" Padding="8,4"/>
                                    <Button Content="Remove"
                                Command="{Binding RemoveSelectedCommand}"
                                Style="{StaticResource RsdButton}"
                                Foreground="#EF9A9A"
                                Margin="0,0,0,6" Padding="8,4"/>
                                </WrapPanel>

                                <!-- Barrier list -->
                                <StackPanel x:Name="BarrierListPanel">
                                    <ListBox x:Name="BarrierList"
                                 ItemsSource="{Binding Barriers}"
                                 SelectedItem="{Binding SelectedBarrier}"
                                 local:DragReorderBehavior.Enable="True"
                                 Margin="0,0,0,8"
                                 Style="{StaticResource MellowListBox}"
                                 ItemContainerStyle="{StaticResource MellowListItem}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Color chip -->
                                                    <Rectangle Grid.Row="0" Grid.Column="0"
                                                   Width="14" Height="14" RadiusX="3" RadiusY="3"
                                                   VerticalAlignment="Top" Margin="0,2,0,0"
                                                   StrokeThickness="1" Stroke="#44FFFFFF"
                                                   Fill="{Binding GaugeKey, Converter={StaticResource GaugeToBrushConverter}}"/>

                                                    <!-- Name + thickness -->
                                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical">
                                                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                                       FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding ThicknessShortDisplay, Mode=OneWay}"
                                                       Margin="0,2,0,0" FontStyle="Italic" FontSize="12"
                                                       Foreground="{StaticResource ThicknessTextBrush}"/>
                                                    </StackPanel>

                                                    <!-- Primary: has secondary -->
                                                    <CheckBox Grid.Row="1" Grid.Column="2"
                                                  Margin="0,6,0,0"
                                                  Content="This has a secondary barrier"
                                                  IsChecked="{Binding HasLinkedSecondary}">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:BarrierKind.Primary}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>

                                                    <!-- Secondary: has another secondary -->
                                                    <CheckBox Grid.Row="1" Grid.Column="2"
                                                  Margin="0,6,0,0"
                                                  Content="This has another secondary barrier"
                                                  IsChecked="{Binding HasTwinSecondary}">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:BarrierKind.Secondary}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{DynamicResource MaterialDesignDivider}" Margin="0,0,0,10"/>

                                <!-- CARD: Workloads -->
                                <materialDesign:Card Margin="0,0,0,10" UniformCornerRadius="10">
                                    <StackPanel Margin="14,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="Workloads"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                       
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="mAs/pt"
                                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBox Grid.Row="0" Grid.Column="2"
                                         Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="mAs"
                                         Text="{Binding UserMasText}"
                                         local:EnterUpdatesTextBox.UpdateOnEnter="True"
                                         Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tube current (mA)/pt"
                                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBox Grid.Row="1" Grid.Column="2"
                                         Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="mA"
                                         Text="{Binding UserMaText}"
                                         local:EnterUpdatesTextBox.UpdateOnEnter="True"
                                         Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Exposure time (min)/exam"
                                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBox Grid.Row="2" Grid.Column="2"
                                         Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="min"
                                         Text="{Binding UserFluoroTimeMinText}"
                                         local:EnterUpdatesTextBox.UpdateOnEnter="True"
                                         Margin="0,0,0,10"/>
                                            
                                            </Grid>
                                        <Border Background="#46515C"
BorderBrush="#5E6A76"
BorderThickness="1"
CornerRadius="6"
Padding="12"
Margin="0,0,0,16">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <materialDesign:PackIcon Kind="MapSearch"
                             Width="16"
                             Height="16"
                             Foreground="#6EC6FF"
                             Margin="0,0,8,0"/>
                                                    <TextBlock Text="Iso-Kerma map values per barrier"
               FontWeight="SemiBold"
               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
Opacity="0.6"/>
                                                </StackPanel>
                                                <Grid>
                                              <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <!--<RowDefinition Height="Auto"/>-->
                                            </Grid.RowDefinitions>
                                           
                                            <!--<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="Iso-Kerma map values per barrier"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           Opacity="0.6" Margin="0,4,0,8"/>-->

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Iso-to-scatter dist. ISD (m)"
                                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBox Grid.Row="0" Grid.Column="2"
                                         Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="m"
                                         Text="{Binding UserIsoToScatterDistanceText}"
                                         local:EnterUpdatesTextBox.UpdateOnEnter="True"
                                         Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="mGy/h @ ISD"
                                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBox Grid.Row="1" Grid.Column="2"
                                         Style="{StaticResource RsdTextBox}"
                                         Text="{Binding UserScatterMGyPerHourAt1mText}"
                                         local:EnterUpdatesTextBox.UpdateOnEnter="True"
                                         Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="μGy/mAs @ ISD"
                                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBox Grid.Row="2" Grid.Column="2"
                                         Style="{StaticResource RsdTextBox}"
                                         Text="{Binding UserScatterUGyPermAsText}"
                                         local:EnterUpdatesTextBox.UpdateOnEnter="True"
                                         Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="μGy/(Gy·cm²) @ ISD"
                                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBox Grid.Row="3" Grid.Column="2"
                                         Style="{StaticResource RsdTextBox}"
                                         Text="{Binding UserScatterUGyPerGyCm2Text}"
                                         local:EnterUpdatesTextBox.UpdateOnEnter="True"
                                         Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="DAP (Gy·cm²) [global]"
                                           VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="4" Grid.Column="2"
                                         Style="{StaticResource RsdTextBox}"
                                         Text="{Binding UserDapGyCm2Text}"
                                         local:EnterUpdatesTextBox.UpdateOnEnter="True"/>
                                        </Grid>
                                    </StackPanel>
                                            </Border>
                                        </StackPanel>
                                </materialDesign:Card>

                                <!-- CARD: Compute Trace -->
                                <materialDesign:Card UniformCornerRadius="10">
                                    <StackPanel Margin="14,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <materialDesign:PackIcon Kind="Calculator" Width="20" Height="20"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="Compute Trace"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Border Background="#0C1f6feb" BorderBrush="#221f6feb" BorderThickness="1"
                                    CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold"
                                           Foreground="#64B5F6" FontSize="13"/>
                                        </Border>

                                        <DataGrid ItemsSource="{Binding TraceItems}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      MaxHeight="240"
                                      MinHeight="120">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Step" Binding="{Binding Key}" Width="0.9*"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1.1*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </materialDesign:Card>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= TAB: PARAMETERS ================= -->
            <TabItem Header="Parameters" IsEnabled="{Binding HasActiveDesign}">

                <ScrollViewer Padding="20,16"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="400"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*" MinWidth="400"/>
                        </Grid.ColumnDefinitions>

                        <!-- ══════════════ LEFT COLUMN ══════════════ -->
                        <StackPanel Grid.Column="0">

                            <!-- ─── CARD: Room Geometry ─── -->
                            <!--<Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardBorder}">-->
                            <materialDesign:Card Margin="0,0,0,16" UniformCornerRadius="12">
                                <StackPanel Margin="24,20">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <materialDesign:PackIcon Kind="MeasuringTape"
                          Width="22" Height="22"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <TextBlock Text="Room Geometry" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
            VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0 labels -->
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Room height (ft):"
                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                       Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="Level below height (ft):"
                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                       Margin="0,0,0,6"/>

                                        <!-- Row 1 inputs -->
                                        <TextBox Grid.Row="1" Grid.Column="0"
                     Style="{StaticResource RsdTextBox}"
                     Text="{Binding RoomHeight_ft, UpdateSourceTrigger=LostFocus}"
                     local:EnterUpdatesTextBox.UpdateOnEnter="True"
                     materialDesign:HintAssist.Hint="Enter room height"
                     Margin="0,0,0,16"/>

                                        <TextBox Grid.Row="1" Grid.Column="2"
                     Style="{StaticResource RsdTextBox}"
                     Text="{Binding LevelBelowHeight_ft, UpdateSourceTrigger=LostFocus}"
                     local:EnterUpdatesTextBox.UpdateOnEnter="True"
                     materialDesign:HintAssist.Hint="Enter level below height"
                     Margin="0,0,0,16"/>

                                        <!-- Row 2 labels -->
                                        <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="Source → Floor (ft):"
                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                       Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="2" Grid.Column="2"
                       Text="Source → Ceiling (ft):"
                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                       Margin="0,0,0,6"/>

                                        <!-- Row 3 inputs -->
                                        <TextBox Grid.Row="3" Grid.Column="0"
                     Style="{StaticResource RsdTextBox}"
                     Text="{Binding SourceToFloor_ft, UpdateSourceTrigger=LostFocus}"
                     local:EnterUpdatesTextBox.UpdateOnEnter="True"
                     IsReadOnly="{Binding IsCT}"
                     materialDesign:HintAssist.Hint="Source to floor"
                     Margin="0,0,0,16">
                                            <TextBox.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="In CT: auto-mapped from iso-center height"/>
                                                </ToolTip>
                                            </TextBox.ToolTip>
                                        </TextBox>

                                        <TextBox Grid.Row="3" Grid.Column="2"
                     Style="{StaticResource RsdTextBox}"
                     Text="{Binding SourceToCeiling_ft, UpdateSourceTrigger=LostFocus}"
                     local:EnterUpdatesTextBox.UpdateOnEnter="True"
                     IsReadOnly="{Binding IsCT}"
                     materialDesign:HintAssist.Hint="Source to ceiling"
                     Margin="0,0,0,16">
                                            <TextBox.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="In CT: auto-mapped to (room height − iso-center)"/>
                                                </ToolTip>
                                            </TextBox.ToolTip>
                                        </TextBox>

                                        <!-- CT row -->
                                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                        Margin="0,4,0,0"
                        Visibility="{Binding DataContext.IsCT,
                                             RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Rectangle Height="1" Fill="{DynamicResource MaterialDesignDivider}" Margin="0,0,0,20"/>
                                            <TextBlock Text="CT SCANNER SETTINGS"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,0,0,8" Opacity="0.6"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <RadioButton Grid.Row="0" Grid.Column="0"
                                 Content="120 kVp"
                                 GroupName="CtKvp"
                                 VerticalAlignment="Center"
                                 IsChecked="{Binding CtKvp, Mode=TwoWay,
                                                     Converter={StaticResource EqualsToBool},
                                                     ConverterParameter=120}"/>

                                                <RadioButton Grid.Row="0" Grid.Column="2"
                                 Content="140 kVp"
                                 GroupName="CtKvp"
                                 VerticalAlignment="Center"
                                 IsChecked="{Binding CtKvp, Mode=TwoWay,
                                                     Converter={StaticResource EqualsToBool},
                                                     ConverterParameter=140}"/>

                                                <TextBlock Grid.Row="0" Grid.Column="4"
                               Text="CT Iso-center to floor (ft):"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,0,0,6"/>

                                                <TextBox Grid.Row="1" Grid.Column="4"
                             Style="{StaticResource RsdTextBox}"
                             Text="{Binding CtIsoCenterHeight_ft, UpdateSourceTrigger=LostFocus}"
                             local:EnterUpdatesTextBox.UpdateOnEnter="True"
                             materialDesign:HintAssist.Hint="Enter CT iso-center height"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- ─── CARD: CT Methods ─── -->
                            <materialDesign:Card Margin="0,0,0,16"
                                     UniformCornerRadius="12"
                                     >
                                <StackPanel Margin="24,20">

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <materialDesign:PackIcon Kind="XRayBoxOutline"
                                                     Width="22" Height="22"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        <TextBlock Text="CT Methods (Activates automatically for CT room types)"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!--<TextBlock Text="Activates automatically for CT room types"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Margin="32,0,0,18" Opacity="0.55"/>-->

                                    <!-- CT content (IsCT = true) -->
                                    <StackPanel Visibility="{Binding DataContext.IsCT,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BooleanToVisibilityConverter}}">

                                        <!-- WPF UI InfoBar for workload note -->
                                        <Border Background="#46515C"
        BorderBrush="#5E6A76"
        BorderThickness="1"
        CornerRadius="6"
        Padding="12"
        Margin="0,0,0,16">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <materialDesign:PackIcon Kind="Information"
                                     Width="16"
                                     Height="16"
                                     Foreground="#6EC6FF"
                                     Margin="0,0,8,0"/>
                                                    <TextBlock Text="CT Workload Usage Notes"
                       FontWeight="SemiBold"
                       Foreground="White"/>
                                                </StackPanel>

                                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="White" Opacity="0.9" Margin="0,0,0,4">
            <Run Text="• Scatter map base uses "/>
            <Run Text="Patients/week." FontWeight="SemiBold"/>
                                                </TextBlock>

                                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="White" Opacity="0.9" Margin="0,0,0,4">
            <Run Text="• DLP base uses weekly workload: "/>
            <Run Text="Head DLP × Head scans/wk + Body DLP × Body scans/wk." FontWeight="SemiBold"/>
                                                </TextBlock>

                                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="White" Opacity="0.9" Margin="0,0,0,4">
            <Run Text="• Tertiary Sutton uses weekly workload: "/>
            <Run Text="Body DLP + 0.5 × Head DLP" FontWeight="SemiBold"/>
            <Run Text=" (using weekly body/head totals)." />
                                                </TextBlock>

                                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="White" Opacity="0.9">
            <Run Text="• Contrast weighting, when enabled, is applied to both DLP base and tertiary workload."/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- CT calculation mode -->
                                        <TextBlock Text="CALCULATION MODE"
                                       Style="{StaticResource RsdSectionOverlineTextBlock}"
                                       Opacity="0.6" Margin="0,0,0,8"/>
                                        <ComboBox Style="{StaticResource RsdComboBox}"
                                      materialDesign:HintAssist.Hint="CT calculation mode"
                                      
                                      ItemsSource="{x:Static local:MainViewModel.CtModeOptions}"
                                      DisplayMemberPath="Key"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding CtMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,18"/>
                                        <Rectangle Height="1" Fill="{DynamicResource MaterialDesignDivider}" Margin="0,0,0,16"/>
                                        <!-- Contrast weighting -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <CheckBox Content="Apply contrast weighting"
                                          IsChecked="{Binding CtApplyContrastWeight, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,20,0"/>
                                            <TextBox Style="{StaticResource RsdTextBox}"
                                         materialDesign:HintAssist.Hint="Contrast %"
                                         
                                         Text="{Binding CtContrastPercentText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CtApplyContrastWeight}"
                                         Width="100"
                                         HorizontalContentAlignment="Center"/>
                                        </StackPanel>

                                        <!-- DLP inputs -->
                                        <TextBlock Text="DLP INPUTS"
                                       Style="{StaticResource RsdSectionOverlineTextBlock}"
                                       Opacity="0.6" Margin="0,0,0,10"/>

                                        <!-- Head row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0"
               Text="Head DLP (mGy·cm)"
               Style="{StaticResource RsdSectionOverlineTextBlock}"
               Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="0" Grid.Column="2"
               Text="Head exams / week"
               Style="{StaticResource RsdSectionOverlineTextBlock}"
               Margin="0,0,0,6"/>

                                            <TextBox Grid.Row="1" Grid.Column="0"
             Style="{StaticResource RsdTextBox}"
             Text="{Binding CtDlpHeadPerPatient_mGycm_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             local:EnterUpdatesTextBox.UpdateOnEnter="True"/>

                                            <TextBox Grid.Row="1" Grid.Column="2"
             Style="{StaticResource RsdTextBox}"
             Text="{Binding CtHeadScansPerWeekText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             local:EnterUpdatesTextBox.UpdateOnEnter="True"/>
                                        </Grid>

                                        <!-- Body row -->
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0"
               Text="Body DLP (mGy·cm)"
               Style="{StaticResource RsdSectionOverlineTextBlock}"
               Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="0" Grid.Column="2"
               Text="Body exams / week"
               Style="{StaticResource RsdSectionOverlineTextBlock}"
               Margin="0,0,0,6"/>

                                            <TextBox Grid.Row="1" Grid.Column="0"
             Style="{StaticResource RsdTextBox}"
             Text="{Binding CtDlpBodyPerPatient_mGycm_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             local:EnterUpdatesTextBox.UpdateOnEnter="True"/>

                                            <TextBox Grid.Row="1" Grid.Column="2"
             Style="{StaticResource RsdTextBox}"
             Text="{Binding CtBodyScansPerWeekText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             local:EnterUpdatesTextBox.UpdateOnEnter="True"/>
                                        </Grid>

                                        <!-- Weekly kerma readout tiles -->
                                        <Rectangle Height="1" Fill="{DynamicResource MaterialDesignDivider}" Margin="0,0,0,16"/>
                                        <TextBlock Text="UNSHIELDED AIR-KERMA (mGy / wk)"
                                       Style="{StaticResource RsdSectionOverlineTextBlock}"
                                       Opacity="0.6" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="3">
                                            <Border Background="#1A1976D2" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="HEAD"
                                                   Style="{StaticResource RsdSectionOverlineTextBlock}"
                                                   HorizontalAlignment="Center" Opacity="0.65"/>
                                                    <TextBlock Text="{Binding CtDlpWeek_Head, StringFormat={}{0:F3}}"
                                                   FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#1A1976D2" CornerRadius="8" Padding="12,10" Margin="3,0,3,0">
                                                <StackPanel>
                                                    <TextBlock Text="BODY"
                                                   Style="{StaticResource RsdSectionOverlineTextBlock}"
                                                   HorizontalAlignment="Center" Opacity="0.65"/>
                                                    <TextBlock Text="{Binding CtDlpWeek_Body, StringFormat={}{0:F3}}"
                                                   FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#221565C0" BorderBrush="#441565C0" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="TOTAL"
                                                   Style="{StaticResource RsdSectionOverlineTextBlock}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="#90CAF9" Opacity="0.85"/>
                                                    <TextBlock Text="{Binding CtDlpWeek_Total, StringFormat={}{0:F3}}"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="#90CAF9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- Placeholder when not CT -->
                                    <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,4"
                                    Visibility="{Binding DataContext.IsCT,
