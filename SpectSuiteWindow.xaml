<Window x:Class="RadiationShieldingDesign.SpectSuiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RadiationShieldingDesign"
        Title="SPECT Suite - Nuclear Medicine Shielding" Height="800" Width="1500"
        WindowStartupLocation="CenterOwner">
    <Window.DataContext>
        <local:SpectSuiteViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <local:BoolInvertConverter x:Key="InvertBool"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,2,6,2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>

        <!-- PROTOCOLS -->
        <GroupBox Grid.Column="0" Header="Protocols">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <ComboBox Width="240" ItemsSource="{Binding PresetProtocolNames}" SelectedItem="{Binding PresetToAdd}"/>
                    <Button Content="Add" Command="{Binding AddProtocolCommand}"/>
                    <Button Content="Remove selected" Command="{Binding RemoveProtocolCommand}"/>
                </StackPanel>
                <ListBox DockPanel.Dock="Top" Height="110" Margin="0,4"
                         ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Name}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding PatientsPerWeek}"/>
                                <Run Text="/wk"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel DataContext="{Binding SelectedProtocol}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Name" Style="{StaticResource Lbl}"/>
                        <TextBox Width="220" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Patients/week" Style="{StaticResource Lbl}" Margin="12,2,6,2"/>
                        <TextBox Width="60" Text="{Binding PatientsPerWeek, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <TextBlock Text="Injections" FontWeight="Bold" Margin="0,8,0,2"/>
                    <DataGrid ItemsSource="{Binding Injections}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" MaxHeight="130">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Nuclide" Width="*"
                                ItemsSource="{x:Static local:SpectSuiteViewModel.NuclideNames}"
                                SelectedItemBinding="{Binding NuclideId, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Activity (MBq)" Width="*"
                                Binding="{Binding ActivityMBq, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Time (min)" Width="*"
                                Binding="{Binding TimeMin, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X"
                                                Command="{Binding DataContext.RemoveInjectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Add injection" HorizontalAlignment="Left"
                            Command="{Binding DataContext.AddInjectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <TextBlock Text="Location segments (min since first injection)" FontWeight="Bold" Margin="0,8,0,2"/>
                    <DataGrid ItemsSource="{Binding Segments}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Region" Width="*"
                                ItemsSource="{x:Static local:SpectSuiteViewModel.RegionNames}"
                                SelectedItemBinding="{Binding Region, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Start (min)" Width="*"
                                Binding="{Binding StartMin, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="End (min)" Width="*"
                                Binding="{Binding EndMin, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X"
                                                Command="{Binding DataContext.RemoveSegmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Add segment" HorizontalAlignment="Left"
                            Command="{Binding DataContext.AddSegmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <TextBlock Text="{Binding NotesText}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,8,0,0"/>
                </StackPanel>
            </DockPanel>
        </GroupBox>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- BARRIERS -->
        <GroupBox Grid.Column="2" Header="Barriers">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Button Content="Add barrier" Command="{Binding AddBarrierCommand}"/>
                    <Button Content="Remove selected" Command="{Binding RemoveBarrierCommand}"/>
                </StackPanel>
                <ListBox DockPanel.Dock="Top" Height="110" Margin="0,4"
                         ItemsSource="{Binding Barriers}" SelectedItem="{Binding SelectedBarrier}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                <Run Text="  "/>
                                <Run Text="{Binding Summary, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedBarrier}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource Lbl}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="Material (new)" Style="{StaticResource Lbl}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                                      ItemsSource="{x:Static local:SpectSuiteViewModel.MaterialNames}"
                                      Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Text="Occupancy (T)" Style="{StaticResource Lbl}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Occupancy, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="3" Text="Area" Style="{StaticResource Lbl}"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <RadioButton Content="Uncontrolled (0.02)" Margin="0,2,12,2"
                                             IsChecked="{Binding IsControlled, Converter={StaticResource InvertBool}}"/>
                                <RadioButton Content="Controlled (0.1)" Margin="0,2"
                                             IsChecked="{Binding IsControlled}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="4" Text="P_week (mSv)" Style="{StaticResource Lbl}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="70" Text="{Binding PWeekMSv, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="Hourly check (0.02 mSv/h)" Margin="12,2" VerticalAlignment="Center"
                                          IsChecked="{Binding HourlyCheck}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Regions seen" FontWeight="Bold" Margin="0,8,0,2"/>
                        <DataGrid ItemsSource="{Binding Regions}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Sees" Binding="{Binding Sees, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Region" Width="*" IsReadOnly="True" Binding="{Binding Region}"/>
                                <DataGridTextColumn Header="Distance (m)" Width="*"
                                    Binding="{Binding DistanceM, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Max simultaneous pts" Width="*"
                                    Binding="{Binding MaxSimultaneousPatients, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Pre-existing layers" FontWeight="Bold" Margin="0,8,0,2"/>
                        <DataGrid ItemsSource="{Binding PreExisting}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" MaxHeight="150">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Material" Width="*"
                                    ItemsSource="{x:Static local:SpectSuiteViewModel.MaterialNames}"
                                    SelectedItemBinding="{Binding Material, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Thickness (mm)" Width="*"
                                    Binding="{Binding ThicknessMm, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="X"
                                                    Command="{Binding DataContext.RemoveLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Add layer" HorizontalAlignment="Left"
                                Command="{Binding DataContext.AddLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>

        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- RESULTS -->
        <GroupBox Grid.Column="4" Header="Results (selected barrier)">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedBarrier}">
                    <TextBlock Text="{Binding RequiredText}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock>
                        <Run Text="Governing limit: "/>
                        <Run Text="{Binding Governing, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Text="{Binding WeeklyHourlyText}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap"/>

                    <TextBlock Text="Per-nuclide breakdown (mSv, unshielded -> shielded at required thickness)"
                               FontWeight="Bold" Margin="0,8,0,2" TextWrapping="Wrap"/>
                    <DataGrid ItemsSource="{Binding Breakdown}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nuclide" Binding="{Binding Nuclide}"/>
                            <DataGridTextColumn Header="Unsh. wk" Binding="{Binding UnshieldedWeek}"/>
                            <DataGridTextColumn Header="Unsh. hr" Binding="{Binding UnshieldedHour}"/>
                            <DataGridTextColumn Header="TF pre-existing" Binding="{Binding PreTransmission}"/>
                            <DataGridTextColumn Header="Shielded wk" Binding="{Binding ShieldedWeek}"/>
                            <DataGridTextColumn Header="Shielded hr" Binding="{Binding ShieldedHour}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Warnings" FontWeight="Bold" Margin="0,8,0,2"/>
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="DarkOrange" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Trace" FontWeight="Bold" Margin="0,8,0,2"/>
                    <ItemsControl ItemsSource="{Binding Trace}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,1">
                                    <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text=": "/>
                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
