<Window x:Class="RadiationShieldingDesign.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RadiationShieldingDesign"
        mc:Ignorable="d"
        Title="About Radiation Shielding Designer"
    Height="360"
    Width="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Icon="pack://application:,,,/Data/favicon256.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#F4F4F4"
                CornerRadius="8"
                Padding="16">
            <StackPanel>
        <!-- HEADER -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,14">
            <Image Source="pack://application:,,,/Data/favicon256.ico"
               Width="48" Height="48"
               Margin="0,0,14,0"/>

            <StackPanel>
                <TextBlock Text="Radiation Shielding Designer (RSD)"
                       FontSize="20"
                       FontWeight="Bold"/>
                <TextBlock Text="Diagnostic and Nuclear Medicine Shielding"
                       Opacity="0.75"/>
            </StackPanel>
        </StackPanel>
                <!-- Divider -->
                <Separator Margin="0,6,0,12"/>
                <!-- Body text -->
                <TextBlock TextWrapping="Wrap" Height="43">
                    An aided tool for diagnostic x-ray and nuclear medicine
                    shielding calculations (NCRP-147 and AAPM TG-108 workflow).
                </TextBlock>
                <StackPanel Grid.Row="1">
                    <TextBlock FontWeight="SemiBold">
                    Sam Alam, PhD, DABR
                    </TextBlock>
                    <TextBlock>
                    Weill Cornell Medicine – Medical Health Physics
                    </TextBlock>
                    <TextBlock>  All Rights Reserved © 2025
                    </TextBlock>
                </StackPanel>
                <Separator Margin="0,12,0,12"/>
                <!-- FOOTER -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Right">
                    <Button Content="OK" Width="90" IsDefault="True" IsCancel="True"/>
        </StackPanel>
            </StackPanel>
        </Border>
    </Grid>


</Window>
