<Window x:Class="RadiationShieldingDesign.ExportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Report" Width="820" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#111" Foreground="White">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel>

                <TextBlock Text="Report Profile" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <GroupBox Header="Institution / Letterhead" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Institution:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InstitutionName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dept line 1:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding DepartmentLine1, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Dept line 2:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding DepartmentLine2, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Address line 1:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Address line 2:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Phone:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" Text="{Binding PhoneLine, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Facility" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Facility name:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FacilityName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Facility address:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                 Text="{Binding FacilityAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Physicist / Signature" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PhysicistName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Credentials:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                 Text="{Binding PhysicistCredentials, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Position:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                                 Text="{Binding PhysicistTitle, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="License State/NO.:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"
                                 Text="{Binding LicenseLine, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Row="4" Grid.Column="1" Margin="0,10,0,0"
                                Content="Load Signature (PNG)..."
                                Click="LoadSignature_Click"/>

                        <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="5"
                                Margin="12,0,0,0" Background="#222" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Signature preview" Margin="0,0,0,6"/>
                                <Image Height="120" Stretch="Uniform"
                                       Source="{Binding SignatureImage}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </GroupBox>

                <TextBlock Text="PDF export will be added after the DOCX layout is locked. For now: generate DOCX → Save As PDF in Word."
                           Opacity="0.8" TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Generate Word (DOCX)..." Width="190" Margin="0,0,10,0" Click="GenerateWord_Click"/>
            <Button Content="Generate PDF..." Width="140" IsEnabled="False"/>
            <Button Content="Close" Width="120" Margin="10,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
